# ---------------------------------------------------------------------------
# Dentist Finder configuration
#
# Copy this file to `.env.local` (git-ignored) and adjust as needed.
# Every value here is read server-side only. Never prefix a secret with
# NEXT_PUBLIC_ - that would ship it to the browser.
# ---------------------------------------------------------------------------

# Which data provider to use.
#   osm    - OpenStreetMap: Nominatim for ZIP geocoding, Overpass for dentists.
#            Free, no API key, no billing account. This is the default.
#   google - Google Places (New) + Geocoding. Requires GOOGLE_MAPS_API_KEY,
#            billing enabled on the Cloud project, and both APIs enabled.
#            Billed per search. Note that Places has no email field and caps
#            results at 60, so the Email column is always empty and
#            "All (no limit)" means "up to 60".
MAP_PROVIDER=osm

# --- OpenStreetMap provider (optional) -------------------------------------
# Nominatim requires a descriptive, application-specific User-Agent, and asks
# that you use your own contact address so they can reach you if your traffic
# causes trouble. Please set this before deploying anything public.
# OSM_USER_AGENT=DentistFinder/1.0 (you@example.com)

# Point these at your own instances if you run them. Defaults are the public
# endpoints, which are shared, rate limited, and best used sparingly.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter
#
# OVERPASS_URL accepts a comma-separated list in preference order. The first is
# used for every request; the rest are tried only when one cannot be reached or
# returns a 5xx. This helps when the public endpoint stops accepting
# connections, which it does under load.
#
#   OVERPASS_URL=https://overpass-api.de/api/interpreter,https://your-mirror/api/interpreter
#
# WARNING: only add mirrors that carry the region you search. Public Overpass
# instances differ in coverage - overpass.osm.ch, for example, answers quickly
# but holds only Swiss data, so using it as a fallback for US searches would
# silently return "0 dentists found" instead of an error. Verify a mirror with a
# query in your area before trusting it.

# --- Google provider -------------------------------------------------------
# Server-side key, never exposed to the browser. With MAP_PROVIDER=google and
# this unset, the app fails at startup with:
#   "Google provider selected but GOOGLE_MAPS_API_KEY is not configured."
#
# The Cloud project also needs billing enabled - Maps Platform rejects every
# request without it, even within the free monthly credit - plus the Geocoding
# API and Places API (New) enabled, and a key that is not restricted to HTTP
# referrers (this key is used server-side). Google's own explanation for any of
# these is passed through to the server log.
# GOOGLE_MAPS_API_KEY=
